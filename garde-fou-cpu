def statut(_args):
    e = lire_json(ETAT, None)
    if not e:
        sys.exit('pas encore d etat (le timer garde-fou-cpu.timer tourne-t-il ?)')
    m, v = e['moyennes_pct_vps'], e['steal_pct']
    print(f"maj {e['maj']} — niveau {e['niveau']}")
    print(f"CPU du VPS (hors steal, % des 2 coeurs) : 5 min {m['5']} | 10 min {m['10']} | 30 min {m['30']} | 60 min {m['60']}")
    print(f"steal : 15 min {v['15']} | 30 min {v['30']} | 60 min {v['60']}")
    print(f"seuils : {e['seuils']}")
    a = e['api']
    print(f"API Hostinger : ok={a.get('ok')} plateau={a.get('plateau')} derniers points={a.get('points')} "
          f"dernier ct_set_limits vu={a.get('dernier_ct_set_limits')}")
    if e.get('episode_plafonnement'):
        print(f"EPISODE DE PLAFONNEMENT : {e['episode_plafonnement']}")
    print('candidats :', ', '.join(f"{c['pid']} {c['user']} {c['pct_coeur']}% {c['cmd'][:50]}" for c in e['candidats']) or 'aucun')
    print('actions actives :' if e['actions_actives'] else 'actions actives : aucune')
    for x in e['actions_actives']:
        print(f"  {x['id']} {x['type']} {x['quand']} pids={x['pids']} « {x['commande'][:70]} »")
        print(f"     pourquoi : {x['pourquoi']}\n     annuler  : {x['annuler']}")
    for x in e['actions_recentes'][-5:]:
        print(f"  (passe) {x['id']} {x['type']} {x['quand']} -> {x['etat']}")


def agir(args, fn, types):
    with open(VERROU, 'w') as v:
        fcntl.flock(v, fcntl.LOCK_EX)
        st = lire_json(INTERNE, {'actions': []})
        qui = os.environ.get('SUDO_USER') or nom_user(os.getuid())
        ciblees = [a for a in st.get('actions', []) if a['etat'] == 'actif' and a['type'] in types
                   and (args.id == 'tout' or a['id'] == args.id)]
        if not ciblees:
            sys.exit(f'aucune action active {"/".join(types)} avec l id {args.id} (voir garde-fou-cpu statut)')
        for a in ciblees:
            fn(a, f'{qui} (manuel)')
        ecrire_json(INTERNE, st)


def main():
    global DRY
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = ap.add_subparsers(dest='cmd', required=True)
    t = sp.add_parser('tick')
    t.add_argument('--dry-run', action='store_true')
    t.add_argument('--seuils-test', action='store_true')
    t.add_argument('--cible-test', default=None, help='ne viser que les processus dont la ligne de commande correspond')
    t.add_argument('-v', '--verbeux', action='store_true')
    sp.add_parser('statut')
    sp.add_parser('api')
    for n in ('reprendre', 'liberer'):
        x = sp.add_parser(n)
        x.add_argument('id')
    a = ap.parse_args()
    if a.cmd == 'statut':
        return statut(a)
    if os.geteuid() != 0:
        sys.exit('garde-fou-cpu : root requis pour cette commande')
    os.makedirs(VAR, exist_ok=True)
    if a.cmd == 'tick':
        DRY = a.dry_run
        if a.seuils_test and not a.cible_test and not DRY:
            sys.exit('--seuils-test exige --cible-test ou --dry-run (sinon il briderait de vrais jobs)')
        with open(VERROU, 'w') as v:
            fcntl.flock(v, fcntl.LOCK_EX)
            tick(a)
    elif a.cmd == 'api':
        with open(VERROU, 'w') as v:
            fcntl.flock(v, fcntl.LOCK_EX)
            st = lire_json(INTERNE, {'actions': []})
            r = verifier_api(st, charger_conf(), force=True)
            ecrire_json(INTERNE, st)
            print(json.dumps({k: r.get(k) for k in ('ok', 'erreur', 'plateau', 'points', 'dernier_id_vu',
                                                    'dernier_ct_set_limits')}, ensure_ascii=False, indent=1))
    elif a.cmd == 'reprendre':
        agir(a, reprendre, ('pause',))
    elif a.cmd == 'liberer':
        agir(a, liberer, ('confinement', 'quota'))


if __name__ == '__main__':
    main()
