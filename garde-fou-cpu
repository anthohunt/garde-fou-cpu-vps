def maintenant():
    return time.time()


def iso(t=None):
    return datetime.datetime.fromtimestamp(t or maintenant(), datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')


def fusion(a, b):
    out = json.loads(json.dumps(a))
    for k, v in b.items():
        out[k] = fusion(out[k], v) if isinstance(v, dict) and isinstance(out.get(k), dict) else v
    return out


def appliquer_reglages(c):
    global JOURNAL, JETON, NTFY_ENV, NTFY_ALARM, USER_ALARME, FLUX_ALERTE, API
    r = c['reglages']
    JOURNAL, JETON, NTFY_ENV = r['journal'], r['jeton_hostinger'], r['ntfy_env']
    NTFY_ALARM, USER_ALARME, FLUX_ALERTE = r['commande_alarme'], r['utilisateur_alarme'], r['commande_alerte']
    API = API_BASE + str(r['vm_id']) if r['vm_id'] else ''


def charger_conf(test=False):
    c = DEFAUT
    try:
        with open(CONF) as f:
            c = fusion(c, json.load(f))
    except FileNotFoundError:
        pass
    c = fusion(c, TEST) if test else c
    appliquer_reglages(c)
    return c


